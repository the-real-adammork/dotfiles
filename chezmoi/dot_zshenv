cargo_paths=("${CARGO_HOME:-$HOME/.cargo}/bin")
rustup_bin=""
for rustup_bin in \
    /opt/homebrew/opt/rustup/bin \
    /home/linuxbrew/.linuxbrew/opt/rustup/bin \
    /usr/local/opt/rustup/bin; do
    if [[ -d "$rustup_bin" ]]; then
        break
    fi
    rustup_bin=""
done

if [[ -z "$rustup_bin" ]] \
    && command -v brew >/dev/null 2>&1 \
    && rustup_prefix="$(brew --prefix rustup 2>/dev/null)"; then
    rustup_bin="$rustup_prefix/bin"
fi

[[ -n "$rustup_bin" ]] && cargo_paths+=("$rustup_bin")
path=($cargo_paths $path)
typeset -U path
unset cargo_paths rustup_bin rustup_prefix
export EDITOR="nvim"
unset BAT_CONFIG_PATH
